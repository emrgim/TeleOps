# TeleOps environment (all optional). Copy to .env or to the systemd EnvironmentFile, chmod 600.
# Everything else (bots, API keys, webhooks, database, appearance) is set from the config page.

# HTTP listener — keep it on loopback and publish it through a reverse proxy / tunnel
TELEOPS_HOST=127.0.0.1
TELEOPS_PORT=8811
# Public base URL (OAuth issuer, links in the config page), e.g. https://teleops.example.com
TELEOPS_PUBLIC_URL=
# Data directory (default: ~/.local/share/teleops, macOS: ~/Library/Application Support/TeleOps, Windows: %LOCALAPPDATA%\TeleOps)
TELEOPS_DATA_DIR=
# Database URL; overrides the one chosen in the config page (sqlite:///path.db | postgres://… | mysql://…)
TELEOPS_DB_URL=
# Server language for MCP tools, errors and the Telegram login code: en | it (default: OS language)
TELEOPS_LANG=
# Logging: trace | debug | info | warn | error
TELEOPS_LOG_LEVEL=info
# Webhook chat allowlist (optional). Unset = forward every matching event (default).
# Set (even empty) = only forward events from these chats; empty = forward nothing.
# Messages are always stored in the database. Comma or whitespace separated chat ids or @usernames.
# Example: WEBHOOK_ALLOW_CHATS=123456789,-1001234567890,@mychannel
# WEBHOOK_ALLOW_CHATS=
# "System" appearance: path or URL of a desktop theme colors.toml (default: auto-detected)
TELEOPS_THEME=

# stdio proxy (`teleops stdio`) for MCP clients that only speak stdio
TELEOPS_MCP_URL=http://127.0.0.1:8811/mcp
TELEOPS_API_KEY=

# Feedback, crash/malfunction reports and auto-update (defaults: this project's public repo)
# TELEOPS_FEEDBACK_REPO=owner/repo
# TELEOPS_FEEDBACK_TOKEN=github_pat_...      # fine-grained, only "Issues: read & write" on TELEOPS_FEEDBACK_REPO
# TELEOPS_UPDATE_REPO=owner/repo
# TELEOPS_UPDATE_INTERVAL_MIN=5

# Licenses through Polar: off unless an organization is set (TeleOps is free)
# TELEOPS_POLAR_ORG_ID=
# TELEOPS_POLAR_SANDBOX=1
# Telegram Bot API server (default https://api.telegram.org): a local telegram-bot-api server, or a test double
TELEOPS_BOT_API=
