# systemd user unit — copy to ~/.config/systemd/user/, adjust the paths, then:
#   systemctl --user daemon-reload && systemctl --user enable --now teleops
#   loginctl enable-linger "$USER"   # keep it running after logout
[Unit]
Description=TeleOps — Telegram bots REST API + MCP server (Bot API, several bots)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/TeleOps
Environment=NODE_ENV=production
# Environment=TELEOPS_PUBLIC_URL=https://teleops.example.com
EnvironmentFile=-%h/.config/teleops.env
# use an absolute path to Node >= 24 if `node` is not on systemd's PATH
ExecStart=/usr/bin/env node dist/main.js
Restart=always
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
